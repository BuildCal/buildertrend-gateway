{
  "name": "gateway",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Buildertrend Gateway \u2014 one door for reads and draft writes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "bt-gateway": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp": "tsx src/cli.ts mcp",
    "serve": "tsx src/cli.ts serve",
    "sync": "tsx src/cli.ts sync",
    "login": "tsx src/cli.ts login",
    "capture": "tsx src/cli.ts capture",
    "crawl-login": "tsx src/cli.ts crawl-login",
    "crawl": "tsx src/cli.ts crawl",
    "crawl-doc": "tsx src/cli.ts crawl-doc"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "hono": "^4.7.10",
    "pg": "^8.14.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "playwright": "1.63.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
